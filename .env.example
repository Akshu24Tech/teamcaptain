# ---------------------------------------------------------------------------
# LLM — any OpenAI-compatible endpoint. All three options below cost ₹0.
# Model names change over time: check your provider's console for current ones.
# ---------------------------------------------------------------------------

# Option A (default): Groq free tier — fast, no card needed. Key: https://console.groq.com
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Option B: Ollama, fully local and offline (needs ~8 GB free RAM for a 7B model)
#   ollama pull qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# Option C: Google Gemini free tier, via its OpenAI-compatible endpoint
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=
# LLM_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Telegram — free. Create a bot with @BotFather, then send it /setprivacy → Disable
# so it can read normal group messages (not just /commands).
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Infrastructure (docker compose up -d)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://teamcaptain:teamcaptain_pw@localhost:5434/teamcaptain
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
APP_PORT=8000

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
TIMEZONE=Asia/Kolkata
CONFIRMATION_TIMEOUT_HOURS=24
REMINDER_LEAD_HOURS=24
ESCALATION_DELAY_HOURS=24
NO_DEADLINE_CHECKIN_DAYS=3
STANDUP_CRON=TZ=Asia/Kolkata 0 21 * * *
